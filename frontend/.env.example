# Base URL of the backend admin API — used by every /admin/* call and by
# the login endpoints. See backend/.env.example's FRONTEND_ORIGIN for the
# matching CORS setting (which must allow credentials, because the
# session's refresh token travels as a cookie).
VITE_ADMIN_API_BASE_URL="http://localhost:3000"

# No admin token here any more: operators sign in with email + password
# (`cd backend && npm run admin:create` seeds the first account) and the
# console holds a short-lived access token in memory. The shared
# ADMIN_API_TOKEN is now a service credential for scripts and CI only —
# putting it in a VITE_ variable would inline it into the shipped bundle.
