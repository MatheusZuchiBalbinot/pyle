{
	"semi": true,
	"singleQuote": true,
	"trailingComma": "all",
	"printWidth": 150,
	"tabWidth": 2,
	"useTabs": true,
	"arrowParens": "always",
	"bracketSpacing": true,
	"endOfLine": "lf",
	"quoteProps": "as-needed",
	"overrides": [{ "files": ["*.md", "*.yml", "*.yaml"], "options": { "useTabs": false, "proseWrap": "preserve" } }]
}
