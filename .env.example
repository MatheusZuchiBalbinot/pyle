# Read by docker-compose.yml (docker compose auto-loads .env from this
# directory). Change these for anything beyond local dev.

# Control-plane Postgres credentials. backend/.env must then be updated to
# match (CONTROL_PLANE_DATABASE_URL embeds the same user/password).
CONTROL_PLANE_DB_USER=pyle
CONTROL_PLANE_DB_PASSWORD=pyle

# Centrifugo (realtime broker, see infra/centrifugo/config.json). The
# control plane mints connection JWTs with the HMAC secret and publishes
# with the API key — backend/.env must carry the same two values. Generate
# real ones:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CENTRIFUGO_TOKEN_HMAC_SECRET=dev-centrifugo-hmac-secret-change-me
CENTRIFUGO_API_KEY=dev-centrifugo-api-key-change-me

# The secret the demo instances (infra/demo-service) require on /__chaos.
# backend/.env must carry the same value to inject chaos from the console.
DEMO_CHAOS_TOKEN=dev-demo-chaos-token-change-me

# Only needed for `docker compose --profile app up`, which runs the control
# plane, the gateway and the console as containers. They read these
# instead of backend/.env; on the host they still come from backend/.env.
ADMIN_API_TOKEN=dev-admin-token-change-me
ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-me-0123456789
CHAOS_ALLOWED=true
# Managed replicas: the control plane container gets the Docker socket (root
# on the host). DOCKER_GID is the socket's group, so the unprivileged user
# in the container can use it: stat -c %g /var/run/docker.sock
SCALING_ALLOWED=true
DOCKER_GID=0
# Where the browser reaches the API and where the API accepts requests
# from — the console container is published on 8081.
ADMIN_API_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:8081
