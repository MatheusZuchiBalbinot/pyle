# Control-plane Postgres (gateway configuration, traffic samples, alerts,
# AI, accounts) and Redis (rate limits, gateway pub/sub, live instance
# state, request log). Both processes read these: the control plane
# (`npm run start:dev`) and the gateway (`npm run start:gateway`). See
# docker-compose.yml at the repo root.
CONTROL_PLANE_DATABASE_URL="postgresql://pyle:pyle@localhost:45431/control_plane"
CONTROL_PLANE_REDIS_URL="redis://localhost:46379"

# How often SystemHealthService re-checks the control plane's Postgres,
# Redis and the gateway's heartbeat.
SYSTEM_HEALTH_CHECK_INTERVAL_MS=10000

# CORS: the only origin allowed to call the admin API — see frontend/.env.example.
FRONTEND_ORIGIN="http://localhost:5173"

# Service credential for machines only — scripts/, the seeder, the load
# bot, CI and the e2e suites. Operators log in with email + password
# instead (see ADMIN_JWT_SECRET below and `npm run admin:create`); this
# token is deliberately NOT given to the console any more.
ADMIN_API_TOKEN="dev-admin-token-change-me"

# Signs the console's access tokens. At least 32 characters, and not the
# same value as any other secret here: one shared with another system must
# not also be able to mint operator sessions.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_JWT_SECRET="dev-admin-jwt-secret-change-me-0123456789"
# How long an access token lasts (the console refreshes silently before it
# expires) and how long a session can be resumed without logging in again.
ADMIN_ACCESS_TOKEN_TTL_S=900
ADMIN_REFRESH_TOKEN_TTL_DAYS=14
# true only when the console is served over HTTPS: browsers drop a
# `Secure` cookie on plain http://localhost, which looks like a broken
# login rather than a cookie policy.
ADMIN_COOKIE_SECURE=false

# Dev-only operator account, (re)set by every `npm run seed` and by
# `npm run seed:admin`: sign in to the console with these. The seeder
# refuses to run it with NODE_ENV=production.
DEV_ADMIN_EMAIL="admin@pyle.local"
DEV_ADMIN_PASSWORD="pyle-admin-dev"

# Data lifecycle (see src/data-retention/). A soft-deleted consumer (and
# its revoked keys) is hard-purged this many days after deletion; traffic
# samples and instance state events are kept for TRAFFIC_RETENTION_HOURS.
CONSUMER_PURGE_AFTER_DAYS=30
TRAFFIC_RETENTION_HOURS=24
# Read notifications are triage residue; unread ones are never purged.
READ_NOTIFICATION_RETENTION_DAYS=90
# One row per control-plane component transition — small, but not
# unbounded.
SYSTEM_HEALTH_EVENT_RETENTION_DAYS=180

# How often route latency and error-rate alert rules are evaluated.
ALERT_EVALUATION_INTERVAL_MS=10000

# Chaos: lets the console inject latency, errors or downtime into the demo
# instances (infra/demo-service) through their /__chaos endpoint. Dev only:
# leave it false anywhere real. The token must match the repo-root .env
# (compose passes it to the demo instances); at least 16 characters.
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CHAOS_ALLOWED=true
DEMO_CHAOS_TOKEN="dev-demo-chaos-token-change-me"

# Managed replicas: the console can scale the demo services by
# creating demo-service containers through Docker. That uses the Docker
# socket, which is root on the host: dev only. Containers get host ports
# 48200-48299 and mount infra/demo-service read-only.
SCALING_ALLOWED=true
# Absolute host path of infra/demo-service; the default resolves
# ../infra/demo-service from backend/.
# DEMO_SERVICE_SOURCE_DIR=
# How the gateway reaches a managed container's published port.
INSTANCE_CONTAINER_HOST=localhost
INSTANCE_RECONCILIATION_INTERVAL_MS=30000

# AI analyses ("Analisar com IA" in the console) — provider-agnostic: the
# provider is an adapter (see ai-analysis/ai-analysis.module.ts), the model
# is whatever that provider offers. AI_PROVIDER is read at boot; AI_MODEL
# and AI_API_KEY are read lazily on the first analysis, so the app starts
# without them and POST /admin/ai/analyses answers 503 until they're set.
# Providers: anthropic, groq (OpenAI-compatible; pick a tool-calling model,
# e.g. AI_MODEL=openai/gpt-oss-120b). The same key/model also drive the
# console's command assistant (Assistente IA).
AI_PROVIDER=anthropic
AI_MODEL=changeme
AI_API_KEY=changeme

PORT=3000

# ---- Gateway (data plane, `npm run start:gateway`) ----------------------
# Client traffic port and the internal health port (/health, /health/ready).
GATEWAY_PORT=8080
GATEWAY_ADMIN_PORT=8090
# Identifies this gateway process in heartbeats and traffic samples.
# Defaults to gw-<hostname>-<pid>; `npm run dev` sets gw-local and Compose gw-docker.
# GATEWAY_ID=gw-local
# Full configuration reload interval: the fallback for a missed
# pyle:gw:config-changed message (changes normally apply within ~1 s).
GATEWAY_CONFIG_REFRESH_MS=30000
# Traffic samples are flushed every 10 s bucket; must stay 10000.
GATEWAY_METRICS_FLUSH_MS=10000
# Heartbeat to Redis (expires after 3 missed beats).
GATEWAY_HEARTBEAT_MS=5000
# Hard cap per request, retries included.
GATEWAY_MAX_REQUEST_TIMEOUT_MS=60000
# Request log kept in Redis: size, and the fraction of successful (< 400)
# responses sampled into it (errors always go in).
REQUEST_LOG_MAX_ENTRIES=1000
REQUEST_LOG_SUCCESS_SAMPLE_RATE=0.2

# ---- Seed and load bot ----------------------------------------------------
# Where `npm run bot` sends traffic, and the host the seeded instances are
# registered with (host.docker.internal when the gateway runs in compose).
SEED_GATEWAY_URL=http://localhost:8080
SEED_INSTANCE_HOST=localhost
# The control plane the seed creates the demo gateway through (admin API,
# authenticated with ADMIN_API_TOKEN).
SEED_CONTROL_PLANE_URL=http://localhost:3000

# Realtime broker (Centrifugo, docker-compose service "centrifugo").
# CENTRIFUGO_URL is where this process reaches the HTTP API (publish);
# CENTRIFUGO_PUBLIC_URL is what browsers connect to. The
# API key and HMAC secret must match the repo-root .env (compose passes
# them to the container). Generate real ones:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CENTRIFUGO_URL=http://localhost:48000
CENTRIFUGO_PUBLIC_URL=ws://localhost:48000/connection/websocket
CENTRIFUGO_TOKEN_HMAC_SECRET=dev-centrifugo-hmac-secret-change-me
CENTRIFUGO_API_KEY=dev-centrifugo-api-key-change-me
