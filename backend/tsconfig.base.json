{
	// What every workspace compiles with. tsconfig.json (typecheck, tests, editor) and each
	// workspace's tsconfig.build.json extend it.
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"resolvePackageJsonExports": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"declaration": true,
		"removeComments": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"target": "ES2023",
		"sourceMap": true,
		"skipLibCheck": true,
		"strict": true,
		"strictPropertyInitialization": false,
		"types": ["node"]
	}
}
